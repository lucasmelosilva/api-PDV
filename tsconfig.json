{
  "compilerOptions": {
    "outDir": "dist",
    "target": "es2020",
    "module": "Commonjs",
    "esModuleInterop": true,
    "sourceMap": true,
    "rootDirs": ["src" ],
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"]
    }
  },  
  "include": [
    "src"
  ],
  "exclude": [
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}
